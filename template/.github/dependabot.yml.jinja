version: 2
updates:
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    groups:
      npm-development-dependencies:
        dependency-type: development

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
{%- if include_docker %}

  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
{%- endif %}
